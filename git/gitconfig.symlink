[user]
	email = git@sril.email
	name = Stef
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINLJahrGoELZ4U4Q43IhbnC64uneW6JUwr9ahBYezoe5
[init]
	defaultBranch = main
[alias]
	co = checkout
	st = status -sb
	lo = log --graph --decorate --pretty=oneline --abbrev-commit -5
	long = log --graph --decorate --pretty=oneline --abbrev-commit
	wtf = !$ZSH/bin/git-wtf
	yolo = push --no-verify
	fr = push --force-with-lease
	frodo = push --force-with-lease --no-verify
[help]
	autocorrect = 5
[push]
	default = current
	autoSetupRemote = true
[pull]
	rebase = false
[fetch]
	prune = true
[branch]
	sort = -committerdate
[rerere]
	enabled = true
[credential]
	helper = osxkeychain
[core]
	editor = code --wait
	excludesfile = ~/.gitignore_global
[diff]
	tool = vscode
	algorithm = histogram
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[merge]
	tool = vscode
	conflictStyle = zdiff3
[mergetool "vscode"]
	cmd = code --wait $MERGED
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rebase]
	autoStash = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[advice]
	skippedCherryPicks = false
