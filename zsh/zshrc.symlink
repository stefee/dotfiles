# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# homebrew (first, so its completions are on fpath before compinit)
eval "$(/opt/homebrew/bin/brew shellenv)"

# if this ever breaks run "$ brew prefix <toolname>"
export PATH="$PATH:$ZSH/bin"
export PATH="$PATH:$HOME/.cargo/bin"
export PATH="$HOME/.local/bin:$PATH"

# utf-8
export LANG="en_GB.UTF-8"

# your project folder that we can `c [tab]` to
export PROJECTS=$HOME/src

# source every .zsh file in this rep
for config_file ($ZSH/**/*.zsh) source $config_file

# zsh-notify (cloned by script/zsh)
[ -s "$HOME/.config/zsh-notify/notify.plugin.zsh" ] && source "$HOME/.config/zsh-notify/notify.plugin.zsh"

# completions (zsh-completions, Docker Desktop) must be on fpath before compinit
fpath=($HOMEBREW_PREFIX/share/zsh-completions $HOME/.docker/completions $fpath)

# initialize autocomplete here, otherwise functions won't be loaded
autoload -Uz compinit
compinit -u

source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# prompt
autoload -U promptinit && promptinit
prompt pure

# editor
export EDITOR="code --wait"
export VISUAL="$EDITOR"

# fnm
eval "$(fnm env --use-on-cd)"

# kubectl
source <(kubectl completion zsh)

# artifactory
export ARTIFACTORY_USER=$(cat $HOME/.dotfiles/.secrets/ARTIFACTORY_USER)
export ARTIFACTORY_API_KEY=$(cat $HOME/.dotfiles/.secrets/ARTIFACTORY_API_KEY)
export NPM_AUTH=$(echo -n "$ARTIFACTORY_USER:$ARTIFACTORY_API_KEY" | base64)

# sonarqube
export SONARQUBE_TOKEN=$(cat $HOME/.dotfiles/.secrets/SONARQUBE_TOKEN)

# rbenv: shims on PATH now, full init (~0.09s) deferred to the first `rbenv` call
export PATH="$HOME/.rbenv/shims:$PATH"
rbenv() {
  unset -f rbenv
  eval "$(command rbenv init - zsh)"
  rbenv "$@"
}

# jenv: shims on PATH now, full init (~0.12s) deferred to the first `jenv` call
export PATH="$HOME/.jenv/shims:$PATH"
jenv() {
  unset -f jenv
  eval "$(command jenv init -)"
  jenv "$@"
}

# must be sourced last
source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
